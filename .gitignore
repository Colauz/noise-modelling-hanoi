# Data (too large for git)
data/raw/
data/processed/
outputs/models/*

# Keep folder structure
!data/raw/.gitkeep
!data/processed/.gitkeep
!outputs/models/.gitkeep

# Modèle final partagé avec l'équipe (entraîné par scripts/train_large.py)
!outputs/models/surrogate_lgbm_large.pkl

# Sorties de modèle SUIVIES : petites, en texte, et ce sont les sources uniques de tous
# les chiffres publiés (rapport, dashboard, sections de papier). Sans elles le dépôt ne
# peut pas justifier ses propres affirmations. Elles étaient jusqu'ici ajoutées à la main
# avec `git add -f` — cette règle rend le suivi explicite.
!outputs/models/metrics.json
!outputs/models/model_comparison.md
!outputs/models/hybrid_physical.json
!outputs/models/hybrid_residual_lgbm.txt

# Secrets
.env

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/

# OS
.DS_Store

# Caches HF/OSMnx créés à l'exécution des notebooks
cache/
notebooks/cache/
!outputs/models/surrogate_lgbm_v2_uganda.pkl
yolov8n.pt

# Comptages vidéo : petits, coûteux à régénérer (~26 min de YOLO+ByteTrack), utiles à
# l'équipe. Exception explicite à l'exclusion de data/processed/.
!data/processed/hanoi/
!data/processed/hanoi/vehicle_counts.csv

# Metadonnees Eclipse creees par GAMA a l'ouverture du modele
gama/.project
gama/.settings/
