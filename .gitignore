# ============================================================================
#  noise-modelling-hanoi -- what git tracks, and why
#
#  Rule: whether a path is versioned must be readable from the path itself.
#  The previous version of this file relied on negations inside excluded
#  directories, which git cannot honour; measurements.csv and
#  vehicle_counts.csv only survived because someone ran `git add -f`.
#  The patterns below re-include directories first, which is what makes the
#  negations legal. There is no `git add -f` anywhere in this project.
#
#  Note: `#` only starts a comment at the START of a line. Never put a
#  trailing comment after a pattern -- it becomes part of the pattern.
# ============================================================================

# --- data: local by default -------------------------------------------------
# Raw Kobo exports carry collector identities; the 147 traffic videos carry
# faces and licence plates. Neither is published -- see docs/data-sources.md.
data/**
!data/**/
!data/**/README.md
!data/**/.gitkeep

# XLSForms: the survey instrument itself, publishable.
!data/forms/**

# The 363 field measurements, pseudonymised. The primary dataset.
!data/processed/measurements.csv

# The 147 video counts. Small, but ~26 min of GPU to regenerate.
!data/processed/vehicle_counts.csv

# --- environments, caches, build artefacts ----------------------------------
.venv/
cache/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

# Ultralytics weights, downloaded automatically on first run.
yolov8n.pt

# --- secrets ----------------------------------------------------------------
.env

# --- editors, OS, IDE -------------------------------------------------------
# The root .project / .settings ARE tracked on purpose: they let the next team
# open the repository directly as a GAMA project. See simulation/gama/README.md.
.DS_Store
.claude/
.workspace*/
simulation/gama/.project
simulation/gama/.settings/

# --- LaTeX build products ---------------------------------------------------
presentation/*.aux
presentation/*.log
presentation/*.nav
presentation/*.out
presentation/*.snm
presentation/*.toc
presentation/*.vrb

# LaTeX build products (presentation/main.pdf itself is versioned)
presentation/*.fls
presentation/*.fdb_latexmk
presentation/*.synctex.gz
presentation/*.synctex(busy)
presentation/main-notes.*

# The intermediate the four placeholder marks are split out of. The marks
# themselves (logos/*.pdf) are versioned so the deck builds on a fresh clone.
presentation/logos/placeholders.pdf

# The report is now typeset LaTeX. report.tex is source and is versioned;
# report.pdf is versioned too, because it is the deliverable people are sent.
# Everything else in results/report/ is regenerated by scripts/10_build_report.py
# on every run -- tracking generated numbers would give them a second home,
# which is the one thing this project does not allow a metric to have.
results/report/numbers.tex
results/report/tab_*.tex
results/report/*.aux
results/report/*.log
results/report/*.out
results/report/*.toc
results/report/*.fls
results/report/*.fdb_latexmk
results/report/*.synctex.gz

# --- mobile/ (Android) ---
mobile/**/build/
mobile/.gradle/
mobile/local.properties
mobile/.idea/
mobile/**/*.apk
mobile/**/*.aab
mobile/**/*.keystore

# --- deliverables/ ----------------------------------------------------------
# The report, the Overleaf paper and the figures are versioned: they are what
# gets handed over. The transmittal e-mail is not. It names real people, asks
# an open question about co-authorship, and records that 6 GB of unanonymised
# footage has no custodian -- none of which belongs on a public repository.
# It stays local, next to the documents it accompanies.
deliverables/email_draft.md

# LaTeX intermediates under deliverables/. The two PDFs and the two .bbl files
# ARE versioned: the PDFs are what people are sent, and the .bbl lets the
# Overleaf folder compile on upload without a bibtex pass.
deliverables/**/*.aux
deliverables/**/*.log
deliverables/**/*.out
deliverables/**/*.toc
deliverables/**/*.blg
deliverables/**/*.fls
deliverables/**/*.fdb_latexmk
deliverables/**/*.synctex.gz

# The 126 administrative units of Hanoi under the July 2025 reform -- 51 phuong
# and 75 xa -- from OpenStreetMap, simplified to ~11 m. Committed because
# scripts/fetch_hanoi_wards.py is the only thing in this project that touches
# the network, and no figure should depend on Overpass being up.
!data/processed/hanoi_wards.geojson
!data/processed/hanoi_new_developments.geojson
!data/processed/video_index.csv
