# ============================================================================
#  noise-modelling-hanoi -- what git tracks, and why
#
#  Rule: whether a path is versioned must be readable from the path itself.
#  The previous version of this file relied on negations inside excluded
#  directories, which git cannot honour; measurements.csv and
#  vehicle_counts.csv only survived because someone ran `git add -f`.
#  The patterns below re-include directories first, which is what makes the
#  negations legal. There is no `git add -f` anywhere in this project.
#
#  Note: `#` only starts a comment at the START of a line. Never put a
#  trailing comment after a pattern -- it becomes part of the pattern.
# ============================================================================

# --- data: local by default -------------------------------------------------
# Raw Kobo exports carry collector identities; the 147 traffic videos carry
# faces and licence plates. Neither is published -- see docs/data-sources.md.
data/**
!data/**/
!data/**/README.md
!data/**/.gitkeep

# XLSForms: the survey instrument itself, publishable.
!data/forms/**

# The 363 field measurements, pseudonymised. The primary dataset.
!data/processed/measurements.csv

# The 147 video counts. Small, but ~26 min of GPU to regenerate.
!data/processed/vehicle_counts.csv

# --- environments, caches, build artefacts ----------------------------------
.venv/
cache/
__pycache__/
*.py[cod]
*.egg-info/
.ipynb_checkpoints/
.pytest_cache/

# Ultralytics weights, downloaded automatically on first run.
yolov8n.pt

# --- secrets ----------------------------------------------------------------
.env

# --- editors, OS, IDE -------------------------------------------------------
# The root .project / .settings ARE tracked on purpose: they let the next team
# open the repository directly as a GAMA project. See simulation/gama/README.md.
.DS_Store
.claude/
.workspace*/
simulation/gama/.project
simulation/gama/.settings/

# --- LaTeX build products ---------------------------------------------------
presentation/*.aux
presentation/*.log
presentation/*.nav
presentation/*.out
presentation/*.snm
presentation/*.toc
presentation/*.vrb
